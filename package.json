    "vite": "8.3.5"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.0",
    "@effect/platform-bun": "^4.1.0",
    "effect": "^4.1.0",
    "foldkit": "0.170.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0"
